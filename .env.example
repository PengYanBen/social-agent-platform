# Flask
FLASK_ENV=development
SECRET_KEY=change…tion

# Database
DATABASE_URL=sqlite:///social_agent.db

# AI Provider — supports any OpenAI-compatible API
# Options:
#   openai_compat  — generic, set AI_MODEL_BASE_URL + AI_MODEL_API_KEY + AI_MODEL_NAME
#   deepseek       — preset, only need AI_MODEL_API_KEY
#   openai         — preset, only need AI_MODEL_API_KEY
#   qwen           — preset (通义千问), only need AI_MODEL_API_KEY
#   glm            — preset (智谱GLM), only need AI_MODEL_API_KEY
#   kimi           — preset (Moonshot), only need AI_MODEL_API_KEY
#   ollama         — preset (local), no key needed
#   mock           — for testing only
#   none           — disable AI, use rule-based only
AI_PROVIDER_TYPE=openai_compat
AI_MODEL_NAME=deepseek-chat
AI_MODEL_BASE_URL=https://api.deepseek.com/v1
AI_MODEL_API_KEY=

*** RSS Collection
RSS_FETCH_TIMEOUT=30
RSS_MAX_CONTENT_LENGTH=1048576

# JWT Authentication
JWT_EXPIRE_HOURS=24

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_COLLECT_INTERVAL_MINUTES=60
SCHEDULER_ANALYZE_INTERVAL_MINUTES=30
SCHEDULER_PUBLISH_INTERVAL_MINUTES=5
SCHEDULER_METRICS_INTERVAL_MINUTES=360

# NewsNow API (multi-platform hot lists)
# Default: https://newsnow.busiyi.world (public instance)
# Self-host: https://your-newsnow.example.com
NEWSNOW_API_URL=https://newsnow.busiyi.world